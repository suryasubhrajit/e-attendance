# Database Configuration
# For production, use PostgreSQL or MySQL instead of SQLite
# SQLite: file:./dev.db
# PostgreSQL: postgresql://user:password@localhost:5432/attendance_db
# MySQL: mysql://user:password@localhost:3306/attendance_db
DATABASE_URL="file:./dev.db"

# Application Settings
NODE_ENV="production"

# Security
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING"

# Application URL
# Update this to your production domain
NEXTAUTH_URL="http://localhost:3000"

# Optional: Email Configuration (for future features)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="noreply@kmbb.in"

# Optional: File Upload Configuration
# MAX_FILE_SIZE="5242880"  # 5MB in bytes
# ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"
