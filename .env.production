# Production Environment Variables
# Copy this file to .env.production.local and update with your production values

# Database - PostgreSQL (will be set by Vercel Postgres automatically)
# If using external PostgreSQL, use format:
# DATABASE_URL="postgresql://user:password@host:5432/database"
DATABASE_URL="postgresql://user:password@localhost:5432/attendance_db"

# Application
NODE_ENV="production"

# Security - MUST CHANGE THIS!
NEXTAUTH_SECRET="GENERATE_A_SECURE_SECRET_KEY_HERE"

# Production URL
NEXTAUTH_URL="https://yourdomain.com"
